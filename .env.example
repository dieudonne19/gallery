# Copier ce fichier en .env.local (jamais committé) et remplir les valeurs.
# Une valeur par environnement : dev en local, test en CI, production sur l'hébergeur.

# --- Base de données (Neon Postgres) ---
# Une branche Neon par environnement : dev, test, production.
# Neon > Connect > choisir la branche > copier l'URL "pooled" (avec sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Stockage des images (bucket) ---
# Compatible S3. Le SDK AWS lit ces quatre variables tout seul.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
# Nom du bucket
S3_BUCKET="project-images"

# --- Back-office (/admin) ---
# Mot de passe de l'unique admin.
ADMIN_PASSWORD=""
# Clé qui signe le cookie de session. Générer avec : openssl rand -base64 32
SESSION_SECRET=""

# --- Site ---
# URL publique du site (liens de partage, métadonnées).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Contact (page Contact) ---
# Numéro WhatsApp au format international, sans + ni espaces (ex. 261340000000).
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
